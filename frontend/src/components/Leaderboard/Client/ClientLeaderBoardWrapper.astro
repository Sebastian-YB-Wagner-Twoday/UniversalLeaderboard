---
import type { Contest } from "@/model/contest/Contest.model";
import { user } from "@/lib/store/userStore";
import { get } from "@/lib/api/http";
import type { ScoreEntry } from "@/model/scores/ScoreEntry.model";
import ClientLeaderBoard from "./ClientLeaderBoard.vue";

interface Props {
  contestId: string;
}

const { contestId } = Astro.props;

let leaderBoardUser = user.get().user;

const contest: Contest = await get(
  `http://localhost:5212/contest/${contestId}`
).then((response) =>
  response.json().catch((e) => console.log("there was an error: ", e))
);

let scores: ScoreEntry[] | undefined = undefined;

scores = await get(`${Astro.url.origin}/api/leaderboard/${contestId}`).then(
  (response) =>
    response.json().catch((e) => console.log("there was an error: ", e))
);
---

<div>
  <h1>{contest.name}</h1>
  {contest.description ? <p>{contest.description}</p> : ""}
  <ClientLeaderBoard
    contest={contest}
    scores={scores}
    user={leaderBoardUser}
    client:idle={{ timeout: 500 }}
  />
</div>
